# ==============================================================================
# Chemist3 Labs — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local` for local development:
#      cp .env.example .env.local
# 2. Populate variables locally. NEVER commit `.env.local` or secret keys to Git.
# ==============================================================================

# Public Site Configuration (Safe for client-side bundling)
NEXT_PUBLIC_SITE_URL=https://chemist3.com

# Server-Side Runtime Credentials (Private — accessed strictly via process.env on server boundaries)
# Do NOT prefix with NEXT_PUBLIC_
RESEND_API_KEY=
DATABASE_URL=
WEBHOOK_SECRET=
